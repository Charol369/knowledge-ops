# ============== LLM ==============
# DeepSeek 官方端点：DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OpenAI-compatible 供应商：DEEPSEEK_BASE_URL=https://your-provider.example/v1
DEEPSEEK_API_KEY=sk-填入你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型选择
# 当前本地验证供应商暴露 deepseek-v4-pro / deepseek-v4-flash。
# 官方别名 deepseek-chat / deepseek-reasoner 是否可用取决于具体 endpoint，
# 使用前请运行 scripts/smoke_external_interfaces.py 重新验证。
DEEPSEEK_MODEL=deepseek-v4-pro
CHEAP_MODEL=deepseek-v4-flash
PRIMARY_MODEL=deepseek-v4-pro
PREMIUM_MODEL=deepseek-v4-pro

# ============== Embeddings ==============
# 推荐：bge-m3（多语言 1024 维，2.3GB，项目 1 正式选型）
# 速成：bge-small-en/zh-v1.5（130MB，Day4 用过）
EMBED_MODEL=BAAI/bge-m3

# ============== Vector DB ==============
# 本地 Milvus Lite（W1 速成）：./data/milvus_demo.db
# Docker Milvus standalone（Sprint 3+）：http://localhost:19530
MILVUS_URI=./data/milvus_demo.db
COLLECTION_NAME=knowledge_ops

# ============== Retrieval ==============
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5

# ============== Generation ==============
MAX_TOKENS=2048
TEMPERATURE=0.3

# ============== LLMOps - LangSmith（Day3 用） ==============
# 注册：https://smith.langchain.com → Settings → API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-ops

# ============== LLMOps - Langfuse（Day6 用 / Sprint 4 主力） ==============
# 云端版（W1-Sprint 3）：https://cloud.langfuse.com
# 自托管（Sprint 4+）：http://localhost:3000（docker compose up 后）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
