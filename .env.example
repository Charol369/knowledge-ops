# ============== LLM ==============
# DeepSeek 官方端点（推荐生产用）：DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 中转站（开发阶段省钱方便）：DEEPSEEK_BASE_URL=https://xxx.qzz.io/v1
DEEPSEEK_API_KEY=sk-填入你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型选择
# - deepseek-chat：通用对话（V4 Pro 系列）
# - deepseek-reasoner：推理模型（R1 系列）
DEEPSEEK_MODEL=deepseek-chat

# ============== Embeddings ==============
# 推荐：bge-m3（多语言 1024 维，2.3GB，项目 1 正式选型）
# 速成：bge-small-en/zh-v1.5（130MB，Day4 用过）
EMBED_MODEL=BAAI/bge-m3

# ============== Vector DB ==============
# 本地 Milvus Lite（W1 速成）：./data/milvus_demo.db
# Docker Milvus standalone（Sprint 3+）：http://localhost:19530
MILVUS_URI=./data/milvus_demo.db
COLLECTION_NAME=knowledge_ops

# ============== Retrieval ==============
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5

# ============== Generation ==============
MAX_TOKENS=2048
TEMPERATURE=0.3

# ============== LLMOps - LangSmith（Day3 用） ==============
# 注册：https://smith.langchain.com → Settings → API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-ops

# ============== LLMOps - Langfuse（Day6 用 / Sprint 4 主力） ==============
# 云端版（W1-Sprint 3）：https://cloud.langfuse.com
# 自托管（Sprint 4+）：http://localhost:3000（docker compose up 后）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
