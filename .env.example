# DeepSeek API（W1 用这个，便宜+国内访问无障碍）
DEEPSEEK_API_KEY=sk-填入你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型选择
# - deepseek-chat：通用对话（DeepSeek V4 Pro 系列）
# - deepseek-reasoner：推理模型（R1 系列）
DEEPSEEK_MODEL=deepseek-chat

# LangSmith（Day3 用）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-ops-w1

# Langfuse（Day6 用）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
